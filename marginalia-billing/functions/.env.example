# Copy this file to ".env" in the same folder and fill in your values (this file is safe to share;
# the secret key is NOT stored here - it goes into Firebase Secret Manager, see README.md).
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
# Lifetime price in paise (Rs 499 = 49900). Use your Play Store lifetime price.
LIFETIME_PRICE_PAISE=49900
# Monthly plan id from Razorpay Dashboard > Subscriptions > Plans (priced like your Play Store monthly plan)
RAZORPAY_MONTHLY_PLAN_ID=plan_XXXXXXXXXXXXXX
