{
  "id": "./",
  "name": "Marginalia — PDF Markup",
  "short_name": "Marginalia",
  "description": "Mark up any PDF — highlight, annotate, cover and retype text, add images and extra writing pages — without touching the original file.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f1f0e9",
  "theme_color": "#2f6659",
  "categories": ["education", "productivity", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": { "application/pdf": [".pdf"] },
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ]
}
